#!/bin/bash
#
# fnOS 生命周期脚本（原生应用，不依赖 Docker）
#
# 要点：
#  · 用飞牛系统自带的 Node.js v22 运行时启动服务
#  · 安装包是 root 权限版（config/privilege 里 run-as: root），进程直接
#    读写全部存储空间 —— 没有"授权目录"这回事
#  · 用 PID 文件做状态判断，应用中心才能显示正确的运行状态
#
# 关于"应用莫名变成已停用"：
#   早先只写 `node index.mjs &`。脚本一退出，飞牛回收本次调用的进程组，
#   服务就跟着被带走了 —— 表现就是应用中心显示已停用、端口不通。
#   现在统一用 nohup + setsid + </dev/null 把它彻底脱离会话；
#   PID 也不再取 $!（setsid 会 fork，$! 可能是个立刻退出的壳），
#   改由服务端自己在 listen 成功后把真实 pid 写进 PID 文件。

set -u

# 脚本自己知道自己在哪：比信任 TRIM_APPDEST 可靠
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
APP_BASE="$(dirname "$SCRIPT_DIR")"

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

PKGVAR="${TRIM_PKGVAR:-/tmp/${TRIM_APPNAME:-fnos-file-viewer}}"
LOG_FILE="$PKGVAR/app.log"
PID_FILE="$PKGVAR/app.pid"
DEFAULT_PORT=8030

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE" 2>/dev/null
}

#
# 定位真正的应用目录。
#
# 为什么不能直接用 $TRIM_APPDEST：它由应用中心按数据库记录拼出来。
# 手工安装「root 型」FPK 时会留下矛盾记录（payload 在 /usr/local/apps/@appcenter/…，
# 而 install_volume_id 写着某个卷号），传进来的 TRIM_APPDEST 就成了一个
# 根本不存在的目录 —— 直接 cd 过去就会报"应用目录不存在"。
# 判据只有一个：**哪份目录里真的有 server/index.mjs**。
resolve_appdest() {
  local cand
  for cand in "${TRIM_APPDEST:-}" "$APP_BASE"; do
    if [ -n "$cand" ] && [ -f "$cand/server/index.mjs" ]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  for cand in "/usr/local/apps/@appcenter/${TRIM_APPNAME:-fnos-file-viewer}" \
              /vol*/@appcenter/"${TRIM_APPNAME:-fnos-file-viewer}" \
              "/var/apps/${TRIM_APPNAME:-fnos-file-viewer}"; do
    if [ -f "$cand/server/index.mjs" ]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  printf '%s' "${TRIM_APPDEST:-$APP_BASE}"
  return 1
}

check_process() {
  kill -0 "$1" 2>/dev/null
}

read_pid() {
  head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]'
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(read_pid)"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  mkdir -p "$PKGVAR" 2>/dev/null
  touch "$LOG_FILE" 2>/dev/null

  local appdest
  appdest="$(resolve_appdest)"
  local app_dir="$appdest/server"

  log_msg "Starting file viewer: port=${TRIM_SERVICE_PORT:-$DEFAULT_PORT} appdest=$appdest user=$(id -un 2>/dev/null) uid=$(id -u 2>/dev/null)"

  if [ ! -f "$app_dir/index.mjs" ]; then
    local msg="文件预览启动失败：找不到服务端入口 $app_dir/index.mjs"
    log_msg "$msg"
    printf '%s' "$msg" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    return 1
  fi

  cd "$app_dir" || {
    local msg2="文件预览启动失败：应用目录不存在 $app_dir"
    log_msg "$msg2"
    printf '%s' "$msg2" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    return 1
  }

  export PORT="${TRIM_SERVICE_PORT:-$DEFAULT_PORT}"
  # 让服务端 listen 成功后自己写 PID，比 $! 可靠
  export FNOS_PID_FILE="$PID_FILE"

  rm -f "$PID_FILE"

  if command -v setsid >/dev/null 2>&1; then
    nohup setsid node index.mjs >> "$LOG_FILE" 2>&1 < /dev/null &
  else
    nohup node index.mjs >> "$LOG_FILE" 2>&1 < /dev/null &
  fi
  disown 2>/dev/null || true

  # 等服务端把真实 pid 写出来；起不来就不会有文件
  local i=0
  while [ "$i" -lt 20 ]; do
    [ -s "$PID_FILE" ] && break
    sleep 0.5
    i=$((i + 1))
  done

  if status_app; then
    log_msg "Started, pid=$(read_pid)"
    return 0
  fi

  local msg3="文件预览启动失败，请查看日志：$LOG_FILE"
  log_msg "$msg3"
  printf '%s' "$msg3" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  return 1
}

stop_app() {
  log_msg "Stopping file viewer..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi

  local pid
  pid="$(read_pid)"
  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi

  kill -TERM "$pid" 2>> "$LOG_FILE" || true

  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done

  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi

  rm -f "$PID_FILE"
  return 0
}

case "${1:-}" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: ${1:-}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
    ;;
esac
