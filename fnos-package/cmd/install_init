#!/bin/bash
#
# 安装前检查（fnOS 在写入应用文件之前调用）
#
# 只做「看一眼环境」的软检查，任何情况下都返回 0 ——
# 真正会阻断安装的硬性条件（端口占用、依赖缺失）由应用中心自己校验。

set -u

PKGVAR="${TRIM_PKGVAR:-/tmp/${TRIM_APPNAME:-fnos-file-viewer}}"
LOG_FILE="${PKGVAR}/app.log"
mkdir -p "$PKGVAR" 2>/dev/null

say() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - [install_init] $1" >> "$LOG_FILE" 2>/dev/null
  echo "[install_init] $1"
}

say "准备安装 ${TRIM_APPNAME:-fnos-file-viewer} ${TRIM_APPVER:-}"
say "系统版本 ${TRIM_SYS_VERSION:-未知}（${TRIM_SYS_ARCH:-未知架构}），内核 ${TRIM_KERNEL_VERSION:-未知}"
say "安装目标 ${TRIM_APPDEST_VOL:-未知存储空间}，服务端口 ${TRIM_SERVICE_PORT:-未声明}"

# 应用依赖系统自带的 Node.js 运行时（manifest: install_dep_apps=nodejs_v22）。
# 依赖由应用中心在安装阶段自动准备，这里只确认一下，缺失也不会中断安装。
NODE_BIN="/var/apps/nodejs_v22/target/bin/node"
if [ -x "$NODE_BIN" ]; then
  say "Node 运行时就绪：$("$NODE_BIN" -v 2>/dev/null)"
else
  say "未发现 $NODE_BIN，应用中心应会自动安装 nodejs_v22 依赖。"
fi

exit 0
