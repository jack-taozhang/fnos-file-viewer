#!/bin/bash
#
# 用户在应用设置里点「保存」之前调用。
#
# 这里**只记录、不主动停服务**。
# 早期版本没有 config_init / config_callback 这一对脚本，飞牛在应用设置变更时
# 会先停掉应用，而没人负责把它拉起来 —— 用户看到的就是"改完设置，应用莫名
# 其妙变成已停用"。现在：init 只打日志，callback 负责重启，状态一定是"运行中"。

set -u

PKGVAR="${TRIM_PKGVAR:-/tmp/${TRIM_APPNAME:-fnos-file-viewer}}"
LOG_FILE="$PKGVAR/app.log"

mkdir -p "$PKGVAR" 2>/dev/null
touch "$LOG_FILE" 2>/dev/null

{
  echo "$(date '+%Y-%m-%d %H:%M:%S') - [config_init] 设置即将变更"
  echo "  服务端口=${TRIM_SERVICE_PORT:-<未声明>}"
} >> "$LOG_FILE" 2>/dev/null

exit 0
